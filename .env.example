# Optional: raises NVD limit from ~5 to ~50 requests / 30s. Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# SQLite cache file (cache only; safe to lose). Use an empty value for memory-only.
CACHE_DB_PATH=data/cache.sqlite3
MAX_BATCH_SIZE=100
# Overall time budget for one request, seconds
REQUEST_DEADLINE_SEC=12
LOG_LEVEL=INFO
